# pnpm settings.
#
# engine-strict: refuse to install under a Node version package.json does not
# allow, rather than failing later in a way that looks like a code bug.
engine-strict=true

# pnpm's default is a strict node_modules where a package can only import what
# it declared. Keep it: undeclared-dependency bugs should surface here, not in
# CI on a different machine.
