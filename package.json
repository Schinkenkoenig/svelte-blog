{
	"name": "blog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build",
		"prepare": "svelte-kit sync || echo \"\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.1",
		"@vitest/coverage-v8": "^5.0.1",
		"browserslist": "^4.29.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"lightningcss": "^1.33.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"shiki": "^4.4.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	},
	"browserslist": [
		">0.5%",
		"last 2 versions",
		"not dead",
		"not op_mini all"
	]
}
